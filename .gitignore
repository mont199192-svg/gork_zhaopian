# 密钥
.env
.env.*
!.env.example

# 本地编辑器配置
.claude/settings.local.json

# 依赖
node_modules/

# 日志
logs/
*.log

# 项目产物与临时文件（体积大，不入库）
projects/*/outputs/
projects/*/work/
projects/*/preview/
projects/*/input/

# 共享素材（体积大 / 版权问题，不入库）
shared/music/
shared/fonts/

# 项目音频素材（配乐有版权、配音可随时用 npm run tts 重新生成）
projects/*/assets/music/
projects/*/assets/sfx/
projects/*/assets/vo/

# 但保留目录占位
!**/.gitkeep

# 系统文件
Thumbs.db
desktop.ini
.DS_Store
