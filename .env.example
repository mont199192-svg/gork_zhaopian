# ============================================
# 媒体 API 配置模板（两个平台）
# ============================================
# 用法：把本文件复制成 .env，填两个密钥。
# .env 已被 .gitignore 忽略，不会进入版本库，也不会出现在聊天里。
# 本文件（.env.example）不要填真实密钥，它是会入库的模板。
#
# 为什么用两家：
#   图片 → 心流（grok-imagine-image-2.0），已验证可用
#   视频 → lk888（gk-video-3.5）
# 心流的 grok-imagine-video-1.5 有三个硬伤，实测确认后弃用：
#   只出横屏、时长只认 15 秒（还经常只给 8 秒）、带参考图必定 422。
# lk888 三项都支持，且失败自动退款。

# --- 密钥（两个都要填）---
# 心流后台复制，形如 sk-xxxxxxxx，令牌分组需为 low。只用于生成图片。
XINLIU_MEDIA_API_KEY=
# lk888 后台复制，形如 sk-xxxxxxxx。只用于生成视频。
LK888_MEDIA_API_KEY=

# --- 接口地址 ---
XINLIU_BASE_URL=https://iliu.ai
LK888_BASE_URL=https://api.lk888.ai

# --- 模型 ---
XINLIU_IMAGE_MODEL=grok-imagine-image-2.0
LK888_VIDEO_MODEL=gk-video-3.5

# --- 心流价格（单位：平台额度，非人民币）---
# 人民币 = 平台额度 × XINLIU_RECHARGE_RATIO
XINLIU_IMAGE_PRICE_PER_CALL=0.08
XINLIU_RECHARGE_RATIO=0.5

# --- lk888 价格（单位：人民币元，直接是最终价）---
# 按秒计费，与画幅无关。480p 价格待确认，暂时按 720p 同价保守估算。
LK888_VIDEO_PRICE_PER_SECOND_720P=0.1656
LK888_VIDEO_PRICE_PER_SECOND_480P=0.1656

# --- 并发与轮询 ---
VIDEO_CONCURRENCY=1
IMAGE_CONCURRENCY=1
# lk888 文档建议 5~10 秒轮询一次。
POLL_INTERVAL_SECONDS=8
# lk888 视频常见耗时 5~60 分钟，超过 70 分钟多半是上游拥堵。
# 心流那边 86 秒就出片，这里要有耐心 —— 别把超时设小了误判成失败。
VIDEO_TIMEOUT_MINUTES=70

# --- 默认生成参数 ---
# gk-video-3.5：时长 1~15 任选（按秒计费），画幅 16:9/9:16/1:1/3:2/2:3，画质 720p/480p。
# 时长按镜头内容定，不要图省事全用同一个值 —— 按秒计费，多一秒就多一秒的钱。
DEFAULT_VIDEO_SECONDS=6
DEFAULT_VIDEO_RESOLUTION=720p
DEFAULT_ASPECT_RATIO=16:9

# --- 安全开关 ---
# true = 每次收费调用前必须人工输入「确认生成」。请勿改成 false。
REQUIRE_CONFIRMATION=true
# 单次批量任务的费用上限（人民币）。超过则直接中止，防止手滑。
MAX_SPEND_PER_BATCH_CNY=10
